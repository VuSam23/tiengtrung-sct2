      },
      {
        "word": "把 / 件 / 瓶 / 张 / 支",
        "py": "bǎ / jiàn / píng / zhāng / zhī",
        "note": "Nhóm lượng từ trọng tâm: 把 (vật có tay cầm như ô dù, ghế), 件 (quần áo), 瓶 (chai, lọ nước hoa/rượu), 张 (vật phẳng như đĩa CD, bản đồ), 支 (vật thon dài như bút)."
      },
      {
        "word": "一点儿 / 有(一)点儿",
        "py": "yìdiǎnr / yǒu(yì)diǎnr",
        "note": "一点儿 đứng trước danh từ hoặc sau tính từ/động từ (买一点儿茶叶 - mua chút trà); 有(一)点儿 đứng trước tính từ để chỉ mức độ hơi quá, thường mang sắc thái không hài lòng (有点儿旧 - hơi cũ)."
      }
    ],
    "grammarTips": [
